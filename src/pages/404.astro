    body{display:flex;align-items:center;justify-content:center;padding:20px;box-sizing:border-box}
    .card{max-width:420px;width:100%;background:#F4E9D2;color:#4B3025;border:4px solid #4B3025;box-shadow:8px 8px 0 #4B3025;padding:26px 22px 24px}

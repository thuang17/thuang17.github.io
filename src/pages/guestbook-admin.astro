---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Guestbook admin" noindex={true}>

<style is:global>
  main{ max-width:820px; margin:0 auto; padding:56px 24px 120px; font-family:var(--f-body); color:var(--fg); }
  [hidden]{ display:none !important; }
  h1{ font-family:var(--f-display); font-size:32px; letter-spacing:-0.02em; margin:0 0 24px; }
  .row{ display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-bottom:22px; }
  input, textarea{ font:inherit; font-size:15px; color:var(--fg); background:#f9f9f9; border:1px solid var(--border); border-radius:10px; padding:10px 12px; box-sizing:border-box; }
  [data-theme="dark"] input, [data-theme="dark"] textarea{ background:#1c1c1c; }
  input{ min-width:260px; }
  textarea{ width:100%; min-height:80px; resize:vertical; }
  button{ font:inherit; font-size:14px; font-weight:600; border-radius:999px; padding:8px 16px; cursor:pointer; border:1px solid var(--border); background:transparent; color:var(--fg); }
  button:hover{ border-color:var(--accent); color:var(--accent); }
  button.primary{ background:var(--accent); border-color:var(--accent); color:#fff; }
  button.danger:hover{ border-color:#B91C1C; color:#B91C1C; }
  .tabs button.on{ background:var(--fg); color:var(--bg); border-color:var(--fg); }
  .item{ border-top:1px solid var(--border); padding:20px 0; }
  .meta{ font-size:13px; color:var(--fg-3); margin-bottom:6px; font-family:var(--f-mono); }
  .meta b{ color:var(--fg); font-family:var(--f-body); font-size:16px; margin-right:8px; }
  .body{ margin:0 0 12px; font-size:17px; line-height:1.55; white-space:pre-wrap; overflow-wrap:anywhere; }
  .item.owner .meta b{ color:var(--accent); }
  .acts{ display:flex; gap:8px; flex-wrap:wrap; }
  .msg{ font-size:14px; color:var(--fg-3); margin:0 0 16px; }
  .err{ color:#B91C1C; }
</style>

<main>
  <h1>Guestbook admin</h1>
  <div class="row" id="login">
    <input id="token" type="password" placeholder="Admin key" autocomplete="off">
    <button class="primary" id="enter" type="button">Sign in</button>
  </div>
  <p class="msg" id="msg"></p>
  <div class="row tabs" id="tabs" hidden>
    <button data-s="pending" class="on" type="button">Pending</button>
    <button data-s="approved" type="button">Approved</button>
    <button data-s="rejected" type="button">Rejected</button>
    <button id="signout" type="button" style="margin-left:auto">Sign out</button>
  </div>
  <div id="list"></div>
</main>

<script>
  const API = (import.meta.env.PUBLIC_GUESTBOOK_API || 'http://127.0.0.1:8787').replace(/\/$/, '');
  const tokenInput = document.getElementById('token');
  const msg = document.getElementById('msg');
  const tabs = document.getElementById('tabs');
  const list = document.getElementById('list');
  const login = document.getElementById('login');
  let status = 'pending';
  let key = sessionStorage.getItem('gb_admin') || '';

  const el = (tag, cls, text) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; };
  const call = async (method, path, body) => {
    const res = await fetch(API + path, { method, headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + key }, body: body ? JSON.stringify(body) : undefined });
    return { status: res.status, data: await res.json().catch(() => ({})) };
  };
  const say = (t, bad) => { msg.textContent = t; msg.className = 'msg' + (bad ? ' err' : ''); };

  async function refresh() {
    say('');
    let r;
    try { r = await call('GET', '/api/admin/posts?status=' + status); } catch { say('Could not reach the server.', true); return; }
    if (r.status === 401) { sessionStorage.removeItem('gb_admin'); key = ''; tabs.hidden = true; login.hidden = false; list.textContent = ''; say('Wrong key.', true); return; }
    login.hidden = true; tabs.hidden = false;
    list.textContent = '';
    if (!r.data.posts.length) { list.append(el('p', 'msg', 'Nothing here.')); return; }
    for (const p of r.data.posts) {
      const item = el('div', 'item' + (p.author === 'owner' ? ' owner' : ''));
      const meta = el('div', 'meta');
      meta.append(el('b', '', p.nickname), document.createTextNode('#' + p.id + (p.parent_id ? ' · reply to #' + p.parent_id : '') + ' · ' + p.created_at.replace('T', ' ').slice(0, 16) + ' UTC · ' + p.status));
      item.append(meta, el('p', 'body', p.body));
      const acts = el('div', 'acts');
      const act = (label, cls, fn) => { const b = el('button', cls, label); b.type = 'button'; b.addEventListener('click', fn); acts.append(b); };
      if (p.status !== 'approved') act('Approve', 'primary', async () => { await call('POST', '/api/admin/posts/' + p.id + '/status', { status: 'approved' }); refresh(); });
      if (p.status !== 'rejected') act('Reject', '', async () => { await call('POST', '/api/admin/posts/' + p.id + '/status', { status: 'rejected' }); refresh(); });
      act('Reply', '', () => {
        if (item.querySelector('textarea')) return;
        const ta = el('textarea'); ta.placeholder = 'Reply as Trevor…'; ta.maxLength = 1000;
        const go = el('button', 'primary', 'Send reply'); go.type = 'button'; go.style.marginTop = '8px';
        go.addEventListener('click', async () => {
          if (!ta.value.trim()) return;
          const rr = await call('POST', '/api/admin/posts/' + p.id + '/reply', { body: ta.value });
          if (rr.status === 201) refresh(); else say(rr.data.error || 'Could not send reply.', true);
        });
        item.append(ta, go); ta.focus();
      });
      act('Delete', 'danger', async () => { if (confirm('Delete #' + p.id + ' and its replies?')) { await call('DELETE', '/api/admin/posts/' + p.id); refresh(); } });
      item.append(acts);
      list.append(item);
    }
  }

  document.getElementById('enter').addEventListener('click', () => { key = tokenInput.value.trim(); if (!key) return; sessionStorage.setItem('gb_admin', key); tokenInput.value = ''; refresh(); });
  tokenInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') document.getElementById('enter').click(); });
  tabs.querySelectorAll('[data-s]').forEach((b) => b.addEventListener('click', () => { status = b.dataset.s; tabs.querySelectorAll('[data-s]').forEach((x) => x.classList.toggle('on', x === b)); refresh(); }));
  document.getElementById('signout').addEventListener('click', () => { sessionStorage.removeItem('gb_admin'); key = ''; tabs.hidden = true; login.hidden = false; list.textContent = ''; });
  if (key) refresh();
</script>

</BaseLayout>

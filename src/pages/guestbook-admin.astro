---
// Moderation page for the guestbook. Pixel-town look, standalone (no site layout).
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Guestbook admin</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/png" sizes="16x16" href="/town/media/favicon-16.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/town/media/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="64x64" href="/town/media/favicon-64.png" />
  <link rel="apple-touch-icon" href="/town/media/avatar-512.png" />
  <style is:global>
    @font-face{font-family:'Jersey 15';font-style:normal;font-weight:400;font-display:swap;src:url(/town/fonts/jersey-15-latin.woff2) format('woff2')}
    :root{--wood:#a34c20;--wood-d:#8c3f19;--ink:#4b3025;--cream:#f4e9d2;--field:#fbe9c4;--gold:#ffd36e;--gold-d:#fbc24b;--red:#b3261e}
    *{box-sizing:border-box}
    html{background:var(--wood)}
    body{margin:0;min-height:100vh;font-family:'Jersey 15',monospace;font-size:22px;line-height:1.35;color:var(--ink);
      background:repeating-linear-gradient(90deg,var(--wood) 0 118px,var(--wood-d) 118px 122px)}
    [hidden]{display:none !important}
    main{max-width:760px;margin:0 auto;padding:40px 20px 120px}
    h1{font-weight:400;font-size:56px;line-height:1;margin:0 0 22px;color:var(--gold);text-shadow:3px 3px 0 var(--ink)}
    .row{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:22px}
    input,textarea{font:inherit;color:var(--ink);background:var(--field);border:3px solid var(--ink);border-radius:0;padding:8px 12px;box-shadow:3px 3px 0 var(--wood-d);outline:none}
    input{min-width:240px;flex:1}
    textarea{width:100%;min-height:90px;resize:vertical;margin-top:10px}
    input:focus,textarea:focus{background:#fff3d0}
    button{font:inherit;color:var(--ink);background:var(--cream);border:3px solid var(--ink);border-radius:0;padding:6px 16px;cursor:pointer;box-shadow:3px 3px 0 var(--ink)}
    button:hover{background:var(--field)}
    button:active{transform:translate(3px,3px);box-shadow:0 0 0 var(--ink)}
    button.primary{background:var(--gold)}
    button.primary:hover{background:var(--gold-d)}
    button.danger{color:var(--red)}
    .tabs button.on{background:var(--ink);color:var(--gold)}
    .item{background:var(--cream);border:3px solid var(--ink);box-shadow:5px 5px 0 var(--ink);padding:16px 18px;margin-bottom:22px}
    .meta{font-size:19px;color:#7a5a45;margin-bottom:6px}
    .meta b{font-weight:400;font-size:26px;color:var(--ink);margin-right:10px}
    .body{margin:0 0 14px;font-size:24px;line-height:1.35;white-space:pre-wrap;overflow-wrap:anywhere}
    .item.owner{background:#ffe9b0}
    .acts{display:flex;gap:10px;flex-wrap:wrap}
    .msg{margin:0 0 18px;color:var(--cream);text-shadow:2px 2px 0 var(--ink)}
    .err{color:#ffb4a8}
    #signout{margin-left:auto}
  </style>
</head>
<body>
<main>
  <h1>Guestbook admin</h1>
  <div class="row" id="login">
    <input id="token" type="password" placeholder="Admin key" autocomplete="off">
    <button class="primary" id="enter" type="button">Sign in</button>
  </div>
  <p class="msg" id="msg"></p>
  <div class="row tabs" id="tabs" hidden>
    <button data-s="pending" class="on" type="button">Pending</button>
    <button data-s="approved" type="button">Approved</button>
    <button data-s="rejected" type="button">Rejected</button>
    <button id="signout" type="button">Sign out</button>
  </div>
  <div id="list"></div>
</main>

<script>
  const API = (import.meta.env.PUBLIC_GUESTBOOK_API || 'http://127.0.0.1:8787').replace(/\/$/, '');
  const tokenInput = document.getElementById('token');
  const msg = document.getElementById('msg');
  const tabs = document.getElementById('tabs');
  const list = document.getElementById('list');
  const login = document.getElementById('login');
  let status = 'pending';
  let key = sessionStorage.getItem('gb_admin') || '';

  const el = (tag, cls, text) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; };
  const call = async (method, path, body) => {
    const res = await fetch(API + path, { method, headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + key }, body: body ? JSON.stringify(body) : undefined });
    return { status: res.status, data: await res.json().catch(() => ({})) };
  };
  const say = (t, bad) => { msg.textContent = t; msg.className = 'msg' + (bad ? ' err' : ''); };

  async function refresh() {
    say('');
    let r;
    try { r = await call('GET', '/api/admin/posts?status=' + status); } catch { say('Could not reach the server.', true); return; }
    if (r.status === 401) { sessionStorage.removeItem('gb_admin'); key = ''; tabs.hidden = true; login.hidden = false; list.textContent = ''; say('Wrong key.', true); return; }
    login.hidden = true; tabs.hidden = false;
    list.textContent = '';
    if (!r.data.posts.length) { list.append(el('p', 'msg', 'Nothing here.')); return; }
    for (const p of r.data.posts) {
      const item = el('div', 'item' + (p.author === 'owner' ? ' owner' : ''));
      const meta = el('div', 'meta');
      meta.append(el('b', '', p.nickname), document.createTextNode('#' + p.id + (p.parent_id ? ' · reply to #' + p.parent_id : '') + ' · ' + p.created_at.replace('T', ' ').slice(0, 16) + ' UTC · ' + p.status));
      item.append(meta, el('p', 'body', p.body));
      const acts = el('div', 'acts');
      const act = (label, cls, fn) => { const b = el('button', cls, label); b.type = 'button'; b.addEventListener('click', fn); acts.append(b); };
      if (p.status !== 'approved') act('Approve', 'primary', async () => { await call('POST', '/api/admin/posts/' + p.id + '/status', { status: 'approved' }); refresh(); });
      if (p.status !== 'rejected') act('Reject', '', async () => { await call('POST', '/api/admin/posts/' + p.id + '/status', { status: 'rejected' }); refresh(); });
      act('Reply', '', () => {
        if (item.querySelector('textarea')) return;
        const ta = el('textarea'); ta.placeholder = 'Reply as Trevor…'; ta.maxLength = 1000;
        const go = el('button', 'primary', 'Send reply'); go.type = 'button'; go.style.marginTop = '10px';
        go.addEventListener('click', async () => {
          if (!ta.value.trim()) return;
          const rr = await call('POST', '/api/admin/posts/' + p.id + '/reply', { body: ta.value });
          if (rr.status === 201) refresh(); else say(rr.data.error || 'Could not send reply.', true);
        });
        item.append(ta, go); ta.focus();
      });
      act('Delete', 'danger', async () => { if (confirm('Delete #' + p.id + ' and its replies?')) { await call('DELETE', '/api/admin/posts/' + p.id); refresh(); } });
      item.append(acts);
      list.append(item);
    }
  }

  document.getElementById('enter').addEventListener('click', () => { key = tokenInput.value.trim(); if (!key) return; sessionStorage.setItem('gb_admin', key); tokenInput.value = ''; refresh(); });
  tokenInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') document.getElementById('enter').click(); });
  tabs.querySelectorAll('[data-s]').forEach((b) => b.addEventListener('click', () => { status = b.dataset.s; tabs.querySelectorAll('[data-s]').forEach((x) => x.classList.toggle('on', x === b)); refresh(); }));
  document.getElementById('signout').addEventListener('click', () => { sessionStorage.removeItem('gb_admin'); key = ''; tabs.hidden = true; login.hidden = false; list.textContent = ''; });
  if (key) refresh();
</script>
</body>
</html>

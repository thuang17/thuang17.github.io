  // Demo video: native controls appear only while the pointer is over it (always on for touch)
  (function () {
    var v = document.querySelector('.phone video');
    if (!v) return;
    if (matchMedia('(hover: none)').matches) { v.controls = true; return; }
    v.controls = false;
    v.addEventListener('mouseenter', function () { v.controls = true; });
    v.addEventListener('mouseleave', function () { v.controls = false; });
    v.addEventListener('focus', function () { v.controls = true; });
    v.addEventListener('blur', function () { v.controls = false; });
